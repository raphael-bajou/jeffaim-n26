---
import { reglages } from "../lib/content";
---

<section id="top" class="relative isolate flex min-h-[100svh] items-center overflow-hidden bg-black pt-24 pb-20">
  <!-- braises animées (canvas) + lueur du feu, cantonnées au bas du hero -->
  <canvas id="embers" class="absolute inset-x-0 bottom-0 -z-10 h-[35%] w-full [mask-image:linear-gradient(to_top,#000_50%,transparent)]" aria-hidden="true"></canvas>
  <div class="fire-glow -z-20 !bottom-[-105%] opacity-60" aria-hidden="true"></div>

  <div class="container-site flex flex-col items-center text-center">
    <h1 class="sr-only">Jef'Faim Pizzas · pizzas au feu de bois</h1>

    <!-- Image telle quelle, sur noir pur (même fond que l'image) -->
    <img
      src="/img/paint.jpg"
      alt="Parmesan, poivrons, tomates, basilic et pommes de terre : les produits frais de Jef'Faim"
      class="mx-auto w-full md:w-3/4 lg:w-2/3"
      width="942"
      height="630"
      fetchpriority="high"
      data-reveal
    />

    <p
      class="mt-2 flex flex-col items-center justify-center px-4 font-sans text-2xl font-bold tracking-widest uppercase md:flex-row"
      data-reveal
      style="--delay:150ms"
    >
      Produits frais
      <span class="text-shine mx-3 font-serif">+</span>
      Feu de bois
      <span class="text-shine mx-3 font-serif">=</span>
      <span class="text-6xl">🍕🤤</span>
    </p>

    <div class="mt-6 flex flex-wrap justify-center gap-2" data-reveal style="--delay:300ms">
      <a href="#carte" class="btn btn-primary">Voir la carte</a>
      <a href="#emplacements" class="btn btn-ghost">Les emplacements</a>
    </div>
  </div>

  <a
    href="#carte"
    class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-[0.65rem] tracking-[0.3em] text-white/40 uppercase transition-colors hover:text-gold-300 md:flex"
    aria-label="Descendre vers la carte"
  >
    Défiler
    <span class="relative h-10 w-px overflow-hidden bg-white/10">
      <span class="absolute inset-x-0 top-0 h-1/2 animate-[scrollhint_1.8s_ease-in-out_infinite] bg-gold-400"></span>
    </span>
  </a>
</section>

<!-- bandeau défilant -->
<div class="marquee overflow-hidden border-y border-white/5 bg-ink-900/60 py-4" aria-hidden="true">
  <div class="marquee-track flex w-max gap-10 font-serif text-xl whitespace-nowrap text-white/50">
    {
      Array.from({ length: 2 }).map(() =>
        reglages.bandeau.map((t) => (
          <span class="flex items-center gap-10">
            {t}
            <span class="text-gold-500">✦</span>
          </span>
        )),
      )
    }
  </div>
</div>

<style>
  @keyframes scrollhint {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(200%);
    }
  }
</style>
