---
import { reglages, telHref, pizzaDuMois } from "../lib/content";
import Facebook from "./Facebook.astro";
import Phone from "./Phone.astro";
---

<header
  id="navbar"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-500 data-[scrolled]:border-b data-[scrolled]:border-white/5 data-[scrolled]:bg-ink-950/70 data-[scrolled]:backdrop-blur-xl"
>
  <nav class="container-site flex h-20 items-center justify-between">
    <a href="#top" class="group flex items-center gap-3" aria-label="Accueil Jef'Faim Pizzas">
      <span
        class="grid h-12 w-12 place-items-center rounded-full bg-ink-900 ring-1 ring-gold-500/40 transition-all duration-500 group-hover:ring-flame-400 group-hover:shadow-[0_0_30px_-4px_rgba(253,227,84,0.6)]"
      >
        <img src="/img/logo.png" alt="" class="h-8 w-8 object-contain" />
      </span>
    </a>
    <ul class="hidden items-center gap-8 text-xs font-semibold tracking-[0.2em] text-white/70 uppercase md:flex">
      {
        pizzaDuMois && (
          <li>
            <a class="nav-link" href="#pizza-du-mois">La pizza du mois</a>
          </li>
        )
      }
      <li><a class="nav-link" href="#carte">La carte</a></li>
      <li><a class="nav-link" href="#emplacements">Où nous trouver</a></li>
    </ul>
    <div class="flex items-center gap-3">
      <a href={reglages.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="text-gold-500 transition-colors hover:text-gold-300">
        <Facebook class="h-6 w-6" />
      </a>
      <a href={telHref(reglages.telephone)} class="btn btn-primary !px-4 !py-2">
        <Phone class="h-4 w-4 text-ink-950" />
        <span class="hidden sm:inline">{reglages.telephone}</span>
        <span class="sm:hidden">Appeler</span>
      </a>
    </div>
  </nav>
</header>

<style>
  .nav-link {
    position: relative;
    transition: color 0.3s;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -6px;
    height: 1px;
    width: 100%;
    background: var(--color-gold-400);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s ease;
  }
  .nav-link:hover {
    color: white;
  }
  .nav-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }
</style>
