---
import { pizzaDuMois as pizza, prix } from "../lib/content";
---

{
  pizza && (
    <section id="pizza-du-mois" class="relative overflow-hidden py-28">
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_center,rgba(151,138,89,0.22),transparent_65%)]"
        aria-hidden="true"
      />
      <div class="container-site">
        <p class="eyebrow mx-auto mb-12 max-w-lg" data-reveal>
          La pizza du mois
        </p>

        <div
          class="halo mx-auto flex max-w-4xl flex-col items-center gap-10 rounded-[2rem] bg-ink-900/90 p-8 md:flex-row md:p-12"
          data-reveal
          style="--delay:120ms"
        >
          {pizza.image ? (
            <div class="relative shrink-0">
              <div class="absolute -inset-6 rounded-full bg-[radial-gradient(closest-side,rgba(234,88,12,0.45),transparent)] blur-2xl" />
              <img
                src={pizza.image}
                alt={pizza.nom}
                class:list={[
                  "slow-spin relative h-56 w-56 rounded-full object-cover shadow-2xl md:h-72 md:w-72",
                  pizza.image_illustrative && "opacity-60 sepia",
                ]}
              />
            </div>
          ) : (
            <div class="relative grid h-48 w-48 shrink-0 place-items-center md:h-64 md:w-64">
              <div class="absolute inset-0 rounded-full bg-[radial-gradient(closest-side,rgba(234,88,12,0.5),rgba(253,227,84,0.08)_70%,transparent)] blur-xl" />
              <div class="slow-spin absolute inset-4 rounded-full border border-dashed border-gold-500/50" />
              <span class="relative text-8xl md:text-9xl">🍕</span>
            </div>
          )}

          <div class="text-center md:text-left">
            <span class="inline-flex items-center gap-2 rounded-full border border-flame-400/40 bg-flame-400/10 px-3 py-1 text-[0.65rem] font-bold tracking-[0.25em] text-flame-400 uppercase">
              <span class="pulse-dot h-1.5 w-1.5 rounded-full bg-flame-400" />
              Ce mois-ci seulement
            </span>
            <h2 class="text-shine mt-4 font-serif text-5xl leading-tight first-letter:uppercase md:text-6xl">{pizza.nom}</h2>
            <p class="mt-2 text-sm tracking-wide text-white/50">Base {pizza.base}</p>
            <ul class="mt-5 flex flex-wrap justify-center gap-2 md:justify-start">
              {pizza.ingredients.map((ing) => (
                <li class="chip !text-xs">{ing}</li>
              ))}
            </ul>
            {pizza.infos && <p class="mt-4 text-gold-300">{pizza.infos}</p>}
            <p class="mt-8 font-serif text-4xl text-white">{prix(pizza.prix)}</p>
          </div>
        </div>
      </div>
    </section>
  )
}
